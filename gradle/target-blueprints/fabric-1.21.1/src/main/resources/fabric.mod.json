{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${mod_java_package}.VisualCreativeTabEditor"
    ],
    "client": [
      "${mod_java_package}.VisualCreativeTabEditorClient"
    ]
  },
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "${fabric_api_version}"
  },
  "mixins": [
    "${mod_id}.fabric_common.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "icon": "assets/${mod_id}/icon.png"
}
